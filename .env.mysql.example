# Salin ke .env.mysql, lalu isi dua kata sandi unik sebelum menjalankan Docker.
# File .env.mysql tidak masuk Git. Salin DB_* ke .env hanya setelah migrasi data selesai.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3308
DB_DATABASE=h2_asia_moora
DB_USERNAME=h2_asia
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
BACKUP_MYSQL_CONTAINER=h2-asia-moora-mysql
